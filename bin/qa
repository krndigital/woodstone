#!/usr/bin/env bash
# One command QA on your Mac: installs what is missing, rebuilds a fresh local database
# with demo users, then runs exactly what CI runs (lint, static analysis, types, tests).
set -euo pipefail
cd "$(dirname "$0")/.."

[ -f .env ] || cp .env.example .env
[ -d vendor ] || composer install --no-interaction
grep -q '^APP_KEY=base64' .env || php artisan key:generate
[ -f database/database.sqlite ] || touch database/database.sqlite
[ -d node_modules ] || npm install

echo "==> Fresh local database with demo users"
php artisan migrate:fresh --seed --force

echo "==> CI checks (lint, Larastan, vue-tsc, tests)"
composer ci:check

echo
echo "QA passed. Start the app with: composer dev   then open http://localhost:8000"
echo "Demo logins (password: password) — owner, manager, cashier, waiter, kitchen, bar, store"
