# cPanel fallback (docs/CPANEL.md): only used when the domain's document root is this folder
# instead of public/. Every request is sent into public/, so nothing outside public/
# (.env, storage/, vendor/, app/) can ever be served. /storage/... maps to public/storage (photos).
<IfModule mod_rewrite.c>
    RewriteEngine On
    # SSL certificate checks (AutoSSL / Let's Encrypt) stay in this folder.
    RewriteRule ^\.well-known/ - [L]
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L,QSA]
</IfModule>
